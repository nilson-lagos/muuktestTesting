{
  "name": "testing-muuktest-rewritten",
  "version": "1.0.0",
  "private": true,
  "description": "Clean Playwright rewrite for MuukTest staging flows",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:dashboard": "playwright test tests/dashboard",
    "test:tests": "playwright test tests/tests",
    "test:schedules": "playwright test tests/schedules",
    "test:mobile": "playwright test tests/mobile",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@muuktest/amikoo-playwright": "^2.1.5"
  }
}
